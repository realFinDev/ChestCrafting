<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>ChestCrafting</AssemblyName>
    <LangVersion>9</LangVersion>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="src/**/*.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="lib/assembly_valheim.dll" Private="false" />
    <Reference Include="lib/assembly_utils.dll" Private="false" />
    <Reference Include="lib/UnityEngine.dll" Private="false" />
    <Reference Include="lib/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="lib/UnityEngine.UI.dll" Private="false" />
    <Reference Include="lib/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="lib/BepInEx.dll" Private="false" />
    <Reference Include="lib/0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
